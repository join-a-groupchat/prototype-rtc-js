# Dockerfile.server
FROM node:20-bullseye-slim

WORKDIR /app

# Copy and install production deps
COPY package*.json ./
RUN npm ci --only=production

# Copy server modular codebase structure
COPY server/ ./server/

# Copy config directory (for .env file structure)
# Note: .env file should be provided via environment variables in production
# The config directory should exist in the repo (even if empty)
COPY config/ ./config/

# Copy public static files
COPY public/ ./public/

EXPOSE 9001
CMD ["node", "server/server-fanout.js"]
